.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Private Android signing material must never enter source control.
*.jks
*.keystore
*.p12

# backend build output
backend/dist/

# IDEs and Editors
.idea/
.vscode/
.commandcode/
*.swp
*.code-workspace

# Environment variables
.env
.env.development
.env.production
.package-lock.json

# Generated QA builds and one-off ingestion output
/artifacts/
/repositories-batch-01.json
/repositories-batch-01-result.json

# Local Azure deployment targets, artifacts and receipts
/.deploy-local/

# Bytecode from the local Azure deployment helpers
/scripts/__pycache__/

# Local Azure deployment tooling and its private verification suite
/scripts/azure_web_release.py
/scripts/deploy-web-azure.py
/tests/azure-deploy.test.ts
