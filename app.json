{
  "expo": {
    "name": "gh-social",
    "slug": "gh-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ghsocial",
    "userInterfaceStyle": "automatic",

    "ios": {},

    "android": {
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}