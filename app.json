{
  "expo": {
    "name": "Weave",
    "slug": "gh-social",
    "version": "2.0.0",
    "description": "Discover open-source repositories and connect with developers.",
    "icon": "./assets/images/logo/weavelogo.png",
    "orientation": "portrait",
    "scheme": "ghsocial",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#151110",
    "ios": {
      "bundleIdentifier": "com.weave.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 4,
      "predictiveBackGestureEnabled": false,
      "package": "com.weave.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/weavelogo.png",
        "backgroundColor": "#151110"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/weavelogo.png",
      "name": "Weave",
      "shortName": "Weave",
      "description": "Discover open-source repositories and connect with developers.",
      "themeColor": "#151110",
      "backgroundColor": "#151110"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#151110",
          "image": "./assets/images/logo/weavelogo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your Weave profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
