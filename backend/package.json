{
  "name": "gh-social-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:outbox": "node dist/worker.js --role=outbox",
    "worker:dev": "tsx worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "schema:audit": "tsx scripts/schema-audit.ts",
    "backfill:v2": "tsx scripts/backfill-v2.ts",
    "db:reset:v2": "tsx scripts/reset-v2.ts",
    "qdrant:audit": "tsx scripts/qdrant-audit.ts",
    "reindex:ml": "tsx scripts/reindex-active-repositories.ts",
    "reindex:personas": "tsx scripts/reindex-user-personas.ts",
    "ingest:trending": "tsx scripts/ingest-github-trending.ts",
    "load:feed:v2": "node scripts/load-feed-v2.mjs",
    "test": "npm run typecheck:test && tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "worker:readme": "node dist/scripts/process-readme-summaries.js",
    "readme:regenerate": "tsx scripts/process-readme-summaries.ts",
    "ml:generate": "node scripts/generate-ml-client.mjs",
    "ml:check": "node scripts/generate-ml-client.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.20",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
