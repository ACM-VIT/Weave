# Supabase Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
DATABASE_URL="postgresql://postgres:your-db-password@your-db-host:6543/postgres"

# Authentication & URLs
# A strong 64+ character random hex string
JWT_SECRET="your-super-secret-jwt-key"
PORT="5000"
# Public backend origin used for OAuth callbacks. Use the origin only: do not
# append /api. Production uses https://weave-backend.krishang.dev.
# Local development derives localhost/emulator/LAN callbacks from the request.
BACKEND_URL="http://localhost:5000"
# For native mobile OAuth: must be the full deep-link callback URL
# The app scheme is "ghsocial" (set in app.json)
# Note: (auth) is an Expo Router route group — parenthesized segments are stripped from URLs
# so the correct path is /callback, NOT /auth/callback
CLIENT_URL="ghsocial://callback"
# Additional exact web origins or native callback URLs accepted after OAuth.
OAUTH_REDIRECT_ORIGINS="http://localhost:8081,ghsocial://callback"
# Short-lived Redis state for OAuth PKCE initiation (allowed range: 60-900).
OAUTH_ATTEMPT_TTL_SECONDS="300"
PASSWORD_RESET_URL="ghsocial://reset-password"

# Comma-separated browser origins. Native apps do not send an Origin header.
# In production, add the deployed web frontend URL(s) here.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# External APIs
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# Internal service-to-service secret
# Must match INTERNAL_API_SECRET in the gh-social-ml .env
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET="your-internal-api-secret-here"
# Previous secret accepted only during a bounded rotation overlap.
INTERNAL_API_SECRET_PREVIOUS=""

# ML Service. Production currently uses https://weaveml.krishang.dev.
# Keep the origin stable and do not append an API path.
ML_SERVICE_URL="http://localhost:8000"
ML_TIMEOUT_MS="5000"
# Durable onboarding/feedback calls may do more work than health and reads.
ML_DELIVERY_TIMEOUT_MS="30000"
# Repository indexing includes bounded generation, repair and embedding work.
ML_REPOSITORY_INDEX_TIMEOUT_MS="240000"
# Must remain at least 60 seconds above ML_REPOSITORY_INDEX_TIMEOUT_MS.
OUTBOX_LEASE_MS="300000"
# First-attempt feedback events per RPC (1..100); 1 disables multi-event batching.
OUTBOX_FEEDBACK_BATCH_SIZE="20"
ML_MAX_RESPONSE_BYTES="1000000"

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Runtime topology
TRUST_PROXY="true"
# Leave blank for the API process. Dedicated worker launch commands set this to
# outbox, feed, or maintenance; do not use all in production.
WORKER_ROLE=""

# V2 runtime flags.
DB_SCHEMA_V2_READS="true"
DB_SCHEMA_V2_WRITES="true"
FEED_V2="true"
FEED_RESERVATIONS="true"
FEED_V2_CANARY_PERCENT="100"
# Cross-session delivery/impression exclusion, in elapsed 24-hour days (1..365).
FEED_RECENT_EXPOSURE_DAYS=7
ML_V2_RECOMMENDATIONS="true"
ML_FEEDBACK_OUTBOX="true"
ML_QDRANT_ONLY="true"
TRENDING_FALLBACK="false"
TRENDING_INGESTION="true"
# Minimum 60000; production defaults to every six hours and also runs immediately on worker start.
TRENDING_INGESTION_INTERVAL_MS="21600000"
# Development may temporarily inspect historical dead rows. Set to 0 for a
# production-equivalent readiness gate.
OUTBOX_MAX_DEAD="100"

# Verification tooling
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_REPOSITORY_COLLECTION=""

# Dedicated README digest worker (server-only; never EXPO_PUBLIC_*).
# Explicit provider: gemini, openrouter, or openai-compatible.
README_SUMMARY_PROVIDER=openrouter
# Key fallback follows the selected provider only: GEMINI_API_KEY/GOOGLE_API_KEY,
# OPENROUTER_API_KEY, or OPENAI_API_KEY. No cross-provider failover.
README_SUMMARY_API_KEY=
README_SUMMARY_MODEL_ID=openai/gpt-4.1-mini
# For Gemini testing: set provider=gemini AND model=gemini-3.1-flash-lite; key=GEMINI_API_KEY.
# Compatible providers require an explicit model and HTTPS API base URL (ending /v1).
README_SUMMARY_BASE_URL=
# Optional per-worker HTTP-attempt RPM (including repair); Gemini otherwise uses
# GEMINI_RPM_LIMIT or 5. Keep one worker within the key's actual provider quota.
README_SUMMARY_RPM_LIMIT=
# OpenRouter retains the API key's privacy guardrails and requires ZDR.
# Start separately: npm run worker:readme

# Enable only after EVERY feed reservation/generation writer is upgraded and
# legacy reservations have drained. See README: Indexed low-watermark refill.
FEED_REFILL_INDEX_READY=false
FEED_REFILL_LOW_WATERMARK=15
FEED_REFILL_TARGET_DEPTH=45

# Opt-in trusted social candidate projection (default false). Deploy the pinned
# social-aware ML contract first; ML mode/traffic controls shadow or enable it.
FEED_SOCIAL_CANDIDATES_ENABLED=false
