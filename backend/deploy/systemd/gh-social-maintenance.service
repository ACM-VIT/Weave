[Unit]
Description=GH Social data reconciliation and telemetry retention worker
Documentation=file:///opt/gh-social/docs/runbooks/v2-cutover-and-rollback.md
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f gh-social-maintenance
ExecStart=/usr/bin/docker run --rm --name gh-social-maintenance --network host --env-file /etc/gh-social/backend.env gh-social-backend:current node dist/worker.js --role=maintenance
ExecStop=/usr/bin/docker stop --time 30 gh-social-maintenance
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
