[Unit]
Description=GH Social durable ML outbox worker
Documentation=file:///opt/gh-social/docs/runbooks/outbox-worker.md
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f gh-social-outbox
ExecStart=/usr/bin/docker run --rm --name gh-social-outbox --network host --env-file /etc/gh-social/backend.env gh-social-backend:current node dist/worker.js --role=outbox
ExecStop=/usr/bin/docker stop --time 300 gh-social-outbox
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Rows are claimed immediately before delivery; one call is bounded by
# ML_REPOSITORY_INDEX_TIMEOUT_MS and shutdown waits for the active run to finish.
TimeoutStopSec=330
UMask=0077

[Install]
WantedBy=multi-user.target
