# Copy to /etc/gh-social/proxy.env, replace every example value, then make the
# file root-owned with mode 600.
BACKEND_DOMAIN=api.example.com
BACKEND_UPSTREAM=127.0.0.1:5000
ACME_EMAIL=ops@example.com

# Validated Caddy 2.10 multi-architecture image, pinned so production does not
# silently move when the floating tag changes.
CADDY_IMAGE=caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
