# Copy to a root-controlled deployment environment file; never commit real
# values. Keep values unquoted because this file is consumed by Docker's
# --env-file parser. The API and outbox worker must read the same file so
# service-to-service credentials cannot drift.

# Supabase / PostgreSQL
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://backend-role:password@database-host:6543/postgres

# Authentication and public origins
JWT_SECRET=replace-with-a-64-plus-character-secret
PORT=5000
# Stable public backend origin used to construct OAuth callbacks. Never append
# /api here.
BACKEND_URL=https://weave-backend.krishang.dev
CLIENT_URL=ghsocial://callback
CORS_ORIGINS=https://your-web-frontend.example
OAUTH_REDIRECT_ORIGINS=https://your-web-frontend.example,ghsocial://callback
OAUTH_ATTEMPT_TTL_SECONDS=300
PASSWORD_RESET_URL=https://your-web-frontend.example/reset-password

# Server-side GitHub API credential used to build signup personas and sync
# public repositories. GitHub signup intentionally fails closed if this is
# absent or GitHub cannot be reached.
GITHUB_TOKEN=github_pat_your_server_token

# Shared backend-to-ML credentials. Preserve the deployed secret; do not rotate
# it merely to launch another process using the same trusted environment file.
INTERNAL_API_SECRET=use-the-existing-deployed-internal-secret
INTERNAL_API_SECRET_PREVIOUS=
ML_SERVICE_URL=https://weaveml.krishang.dev
ML_TIMEOUT_MS=5000
ML_DELIVERY_TIMEOUT_MS=30000
ML_MAX_RESPONSE_BYTES=1000000
ML_CIRCUIT_FAILURE_THRESHOLD=5
ML_CIRCUIT_OPEN_MS=30000

# Shared Redis. Use the existing TLS URL when the provider requires rediss://.
REDIS_URL=rediss://default:password@redis-host:port

# API / worker topology. Leave WORKER_ROLE blank in the shared file. The
# dedicated service supplies WORKER_ROLE=outbox itself.
NODE_ENV=production
WORKER_ROLE=
LEGACY_API_ENABLED=false
TRUST_PROXY=true

# V2 writes and durable delivery stay enabled for ingestion. Recommendation
# reads remain dark until the ingestion canary returns canonical UUID results.
DB_SCHEMA_V2_READS=true
DB_SCHEMA_V2_WRITES=true
FEED_V2=true
FEED_RESERVATIONS=true
ML_V2_RECOMMENDATIONS=false
ML_FEEDBACK_OUTBOX=true
ML_QDRANT_ONLY=true
TRENDING_FALLBACK=true
FEED_V2_SHADOW_PERCENT=0
FEED_V2_CANARY_PERCENT=100

# Readiness fails closed when recommendations have no exact positive eligible
# repository corpus, or when the required feedback consumer release mismatches.
# Keep recommendations disabled until the stricter release-runbook gates pass.

# Optional verification tooling; the runtime backend does not access Qdrant.
QDRANT_URL=https://your-qdrant-host
QDRANT_REPOSITORY_COLLECTION=
