    "schemas": {
      "CardSummaryArtifact": {
        "additionalProperties": false,
        "description": "Versioned summary artifact returned to the canonical backend.",
        "properties": {
          "format_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Format Version",
            "type": "string"
          },
          "highlights": {
            "items": {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 3,
            "title": "Highlights",
            "type": "array"
          },
          "model_version": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "prompt_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Prompt Version",
            "type": "string"
          },
          "source": {
            "enum": [
              "generated",
              "description_fallback"
            ],
            "title": "Source",
            "type": "string"
          },
          "summary": {
            "maxLength": 360,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "prompt_version",
          "model_version",
          "format_version",
          "source"
        ],
        "title": "CardSummaryArtifact",
        "type": "object"
      },
      "FeedbackBatch": {
        "additionalProperties": false,
