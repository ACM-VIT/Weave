            "const": 2,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "events"
        ],
        "title": "FeedbackBatch",
        "type": "object"
      },
      "FeedbackEvent": {
        "additionalProperties": false,
        "properties": {
          "dwell_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dwell Ms"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "enum": [
              "dwell",
              "readme_open",
              "github_open",
              "like",
              "unlike",
              "dislike",
              "undislike",
              "save",
              "unsave",
              "share"
            ],
            "title": "Event Type",
            "type": "string"
          },
          "feedback_version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "pattern": "^[1-9][0-9]*$",
                "type": "string"
              }
            ],
            "title": "Feedback Version"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "repo_id": {
            "format": "uuid",
            "title": "Repo Id",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "user_id",
          "repo_id",
          "feedback_version",
          "event_type",
          "occurred_at"
        ],
        "title": "FeedbackEvent",
        "type": "object"
      },
