# The URL where your Node.js backend is deployed (must include /api).
# Local development can omit this variable: the app automatically uses
# localhost:5000 on web, 10.0.2.2:5000 on Android Emulator, and the Expo LAN
# host on physical devices.
EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com/api

# The local internal-QA artifact builder always overrides the value above with
# https://weave-backend.krishang.dev/api. To target another QA backend, set this
# shell variable when invoking the build script; it must be HTTPS and end in /api:
# WEAVE_ARTIFACT_BACKEND_URL=https://your-qa-backend.example/api

# Public URLs used by legal links, OAuth and deployment smoke tests.
EXPO_PUBLIC_WEB_URL=https://your-web-frontend.example

# Optional public DSN for production crash reporting. Keep SENTRY_AUTH_TOKEN
# outside client-visible variables; never place secrets under EXPO_PUBLIC_*.
EXPO_PUBLIC_SENTRY_DSN=
